# SpeedPy environment variables
# Copy this file to .env and adjust values for your environment.

# --- Core ---
# DEBUG=True
# SECRET_KEY=change_me
# DATABASE_URL=sqlite:///db.sqlite3
# ALLOWED_HOSTS=*

# --- Email ---
# EMAIL_PROVIDER selects the sending backend used behind django-post_office.
# One of: console (dev default), smtp, ses, mailgun, sendgrid, postmark, resend.
# An unknown value fails loudly at startup.
# EMAIL_PROVIDER=console
# DEFAULT_FROM_EMAIL=admin@example.com
# SERVER_EMAIL=admin@example.com   # defaults to DEFAULT_FROM_EMAIL
#
# smtp: connection comes from EMAIL_URL
# EMAIL_URL=smtp://user:password@smtp.example.com:587/?tls=True
#
# API providers (django-anymail). Placeholders boot the app; real keys needed to send.
# ses (AWS SES):
# AWS_SES_ACCESS_KEY_ID=change_me
# AWS_SES_SECRET_ACCESS_KEY=change_me
# AWS_SES_REGION_NAME=eu-central-1
# mailgun:
# MAILGUN_API_KEY=change_me
# MAILGUN_SENDER_DOMAIN=example.com
# MAILGUN_API_URL=https://api.mailgun.net/v3   # use https://api.eu.mailgun.net/v3 for EU
# sendgrid:
# SENDGRID_API_KEY=change_me
# postmark:
# POSTMARK_SERVER_TOKEN=change_me
# resend:
# RESEND_API_KEY=change_me

# --- CORS ---
# Only needed for browser-based SPA clients and OAuth2 interactive flows.
# Server-to-server and CLI clients use PAT/JWT and do not need CORS.
#
# In DEBUG mode, CORS_ALLOW_ALL_ORIGINS defaults to True for local dev.
# A startup guard prevents CORS_ALLOW_ALL_ORIGINS=True when DEBUG=False.
#
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# CORS_ALLOW_ALL_ORIGINS=False
# CORS_ALLOW_CREDENTIALS=False

# --- Object storage (media uploads) ---
# Local disk is the default: nothing to set. On Appliku, attach a volume with the
# environment-variable prefix MEDIA and the platform sets MEDIA_ROOT + MEDIA_URL.
#
# To move media to any S3-compatible provider, install the optional dependency
# (`uv sync --extra s3`) and set these. Full guide: STORAGE_SETUP.md
#
# USE_S3=True
# S3_ACCESS_KEY_ID=change_me
# S3_SECRET_ACCESS_KEY=change_me
# S3_BUCKET_NAME=my-bucket
# S3_REGION_NAME=fra1
# S3_ENDPOINT_URL=https://fra1.digitaloceanspaces.com   # empty for AWS S3
# S3_CDN_BASE=https://cdn.example.com                   # optional
# ACLs are not portable: empty works everywhere. "public-read" for DO Spaces /
# Wasabi. Leave empty on AWS with ACLs disabled and on Cloudflare R2 (no ACLs).
# S3_DEFAULT_ACL=public-read
# S3_SEND_PRIVATE_ACL=True
# S3_SIGNED_URL_EXPIRE=600
# S3_ADDRESSING_STYLE=path                              # MinIO and similar
#
# Local-disk home for private uploads, deliberately outside MEDIA_ROOT:
# PRIVATE_MEDIA_ROOT=/path/outside/media
